# Copy to backend/.env on the VPS (never commit backend/.env)

DJANGO_SECRET_KEY=change-me-use-openssl-rand-hex-32
DJANGO_DEBUG=0
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

DATABASE_URL=postgres://scanno:change-me-long-random@db:5432/scanno

# Must match NEXT_PUBLIC_API_URL origin (scheme + host, no path)
CORS_ALLOWED_ORIGINS=https://app.example.com

USE_S3=1
AWS_ACCESS_KEY_ID=scanno
AWS_SECRET_ACCESS_KEY=change-me-match-minio-root-password
AWS_STORAGE_BUCKET_NAME=scanno
AWS_S3_ENDPOINT_URL=http://minio:9000
# Public URL for browsers (bucket path included if bucket is not at root)
AWS_S3_CUSTOM_DOMAIN=media.example.com/scanno

OPEN_FOOD_FACTS_USER_AGENT=Scanno/1.0 (you@example.com)
