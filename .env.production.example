# Root env for docker compose -f docker-compose.prod.yml
# Copy to .env in repo root on the VPS (never commit .env)

# --- Postgres (docker internal) ---
POSTGRES_DB=scanno
POSTGRES_USER=scanno
POSTGRES_PASSWORD=change-me-long-random

# --- MinIO (docker internal + init) ---
MINIO_ROOT_USER=scanno
MINIO_ROOT_PASSWORD=change-me-long-random
AWS_STORAGE_BUCKET_NAME=scanno

# --- Web build/runtime (public HTTPS API URL) ---
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
