  "board": {
    "name": "Scanno MVP Backlog",
    "desc": "MVP gaps + deploy + social v1 + mobile. Content model = Review on Product (see repo docs/PRODUCT_IDENTITY.md). Repo: plotnikov-sergey-01/scanno"
  },
  "lists": [
    {
      "name": "MVP — доделать",
      "cards": [
        {
          "name": "Комментарии к отзывам (UI)",
          "desc": "**Что:** показывать комментарии под каждым отзывом на `/products/[id]`; форма добавления для залогиненных.\n\n**API уже есть:** `GET/POST /reviews/{id}/comments/`, `api.addComment()` в web.\n\n**Не ломать:** приватный отзыв — комментарии только при доступе к отзыву.",
          "labels": [
            "web",
            "mvp",
            "p1"
          ],
          "checklist": [
            "Список комментариев под отзывом",
            "Форма Add comment + optimistic или reload",
            "Счётчик comment_count обновляется",
            "Ошибки auth/403 обработаны"
          ]
        },
        {
          "name": "Жалоба Report (UI)",
          "desc": "**Что:** кнопка Report на отзыве (и позже на комментарии) → модалка reason + details.\n\n**API:** `POST /reports/` (`target_type`, `target_id`, `reason`).",
          "labels": [
            "web",
            "mvp",
            "p2"
          ],
          "checklist": [
            "Кнопка Report на ReviewCard или product page",
            "Модалка с reason + optional details",
            "Только для auth",
            "Success toast без перезагрузки страницы"
          ]
        },
        {
          "name": "Редактирование user-product на карточке",
          "desc": "**Что:** inline edit name/brand/category/description для `source=user` и `can_edit_image`.\n\n**API:** `PATCH /products/{id}/` (`api.updateProduct`). Catalog/OFF — read-only.",
          "labels": [
            "web",
            "backend",
            "mvp",
            "p2"
          ],
          "checklist": [
            "Кнопка Edit только для creator",
            "Catalog products не редактируются",
            "Сохранение через PATCH",
            "Описание видно после save"
          ]
        },
        {
          "name": "Настройки профиля",
          "desc": "**Что:** страница `/settings` или `/me/edit`: display_name, bio, avatar.\n\n**Backend:** расширить `PATCH /auth/me/` или profile endpoint.",
          "labels": [
            "web",
            "backend",
            "mvp",
            "p2"
          ],
          "checklist": [
            "Форма display_name + bio",
            "Avatar upload (optional v1: URL or file)",
            "Изменения на `/u/[username]`",
            "Только свой профиль"
          ]
        },
        {
          "name": "Web: сканер штрихкода (камера)",
          "desc": "**Что:** на `/search` — Scan via camera (не только ручной ввод). После scan → `lookupBarcode` → redirect на product.",
          "labels": [
            "web",
            "mvp",
            "p3"
          ],
          "checklist": [
            "Кнопка Scan + getUserMedia или библиотека",
            "EAN/UPC decode",
            "Redirect на product или manual create flow",
            "HTTPS note для prod (camera requires secure context)"
          ]
        },
        {
          "name": "Галерея фото отзывов на product page",
          "desc": "**Что:** блок «Photos from shoppers» — все public review images в одной галерее + lightbox (сейчас фото только внутри ReviewCard).",
          "labels": [
            "web",
            "mvp",
            "p3"
          ],
          "checklist": [
            "Агрегация images из reviews",
            "Lightbox как у product photo",
            "Пустое состояние скрыто"
          ]
        }
      ]
    },
    {
      "name": "Deploy & staging",
      "cards": [
        {
          "name": "Staging на DigitalOcean",
          "desc": "**Что:** один droplet, Docker Compose (api + web + postgres + minio), Caddy/Nginx + Let's Encrypt.\n\n**URLs:** `app.<subdomain>`, `api.<subdomain>`.\n\n**Docs:** `docs/DEPLOY.md`.",
          "labels": [
            "infra",
            "p1"
          ],
          "checklist": [
            "Droplet 4GB RAM / 2 vCPU",
            "DNS A records",
            "HTTPS работает",
            "ALLOWED_HOSTS + CORS настроены",
            "Секреты не в git"
          ]
        },
        {
          "name": "Production env checklist",
          "desc": "`DJANGO_DEBUG=0`, strong SECRET_KEY, gunicorn, `NEXT_PUBLIC_API_URL`, USE_S3 or MinIO on server, сменить seed passwords.",
